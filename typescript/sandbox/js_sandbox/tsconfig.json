{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "rootDir": ".",
    "outDir": ".",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ES2020", "DOM"],
    "declaration": false,
    "sourceMap": false,
    "noEmit": false
  },
  "include": ["topics/**/*.ts"],
  "exclude": ["**/*.js", "node_modules"]
}
